# NEXUS Store Configuration

# Printful API (print-on-demand)
PRINTFUL_API_KEY=your_printful_api_key_here

# CJDropshipping API (dropshipping - AliExpress/DHgate products)
# 1. Créez un compte sur https://cjdropshipping.com
# 2. Allez dans My CJ > API > Créer une API Store
# 3. Copiez votre API Key (format: CJUserNum@api@xxxxxxxxxx)
CJ_API_KEY=

# eBay API (Browse API - afficher vos produits eBay sur votre site)
# 1. Créez un compte développeur sur https://developer.ebay.com
# 2. Créez une application (Production Keys)
# 3. Copiez votre App ID (Client ID) et Cert ID (Client Secret)
# 4. Mettez votre nom vendeur eBay dans EBAY_SELLER_NAME
EBAY_CLIENT_ID=
EBAY_CLIENT_SECRET=
EBAY_SELLER_NAME=votre_nom_vendeur_ebay
EBAY_ENVIRONMENT=production

# Stripe API Keys (Get from https://dashboard.stripe.com/apikeys)
STRIPE_SECRET_KEY=sk_test_your_stripe_test_key_here
STRIPE_PUBLISHABLE_KEY=pk_test_your_stripe_publishable_key_here

# Server Configuration
PORT=3000
NODE_ENV=development

# Store Information
STORE_NAME=NEXUS
STORE_EMAIL=contact@nexus-store.com
